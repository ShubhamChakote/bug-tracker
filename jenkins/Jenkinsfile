pipeline {
    agent any

    stages {
        stage('Unit Tests - Backend') {
            agent{
                docker{
                    image 'snakee/golang-junit:1.21' // adding docker image as it required go and junit for running the tests
                    reuseNode true //this ensures it uses image throughout the jenkins pipeline
                    args '-u root'
                }
            }
            steps {
                dir('bugtracker-backend'){
                    sh 'go test -v ./...'
                }
            }
        }
    }
}
